  <worksheets>
    <worksheet name="How many banks had higher or lower deposits?">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="12" bold="true" fontcolor="#142c3a">How many banks had higher or lower deposits?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="DepositCounts" name="textscan.DepositCounts" />
          </datasources>
          <datasource-dependencies datasource="textscan.DepositCounts">
            <column name="[Deposit change]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[Deposit change]" derivation="None" name="[none:Deposit change:nk]" pivot="key" type="nominal" />
            <column name="[Number of banks]" datatype="integer" role="measure" type="quantitative" />
            <column-instance column="[Number of banks]" derivation="Sum" name="[sum:Number of banks:qk]" pivot="key" type="quantitative" />
            <column name="[Label]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[Label]" derivation="None" name="[none:Label:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <sort class="computed" column="[textscan.DepositCounts].[none:Deposit change:nk]" direction="DESC" using="[textscan.DepositCounts].[sum:Number of banks:qk]" />
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
            <format attr="color" value="#183747" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[textscan.DepositCounts].[none:Label:nk]" />
              <color column="[textscan.DepositCounts].[none:Deposit change:nk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#4f708b" />
                <format attr="mark-labels-show" value="true" />
                <format attr="font-size" value="10" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[textscan.DepositCounts].[none:Deposit change:nk]</rows>
        <cols>[textscan.DepositCounts].[sum:Number of banks:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Five largest dollar declines on the 40-bank review list">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="12" bold="true" fontcolor="#142c3a">Five largest dollar declines on the 40-bank review list</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="BankBalances" name="textscan.BankBalances" />
          </datasources>
          <datasource-dependencies datasource="textscan.BankBalances">
            <column name="[Bank]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[Bank]" derivation="None" name="[none:Bank:nk]" pivot="key" type="nominal" />
            <column name="[Report date]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[Report date]" derivation="None" name="[none:Report date:nk]" pivot="key" type="nominal" />
            <column name="[Deposits (USD millions)]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[Deposits (USD millions)]" derivation="Sum" name="[sum:Deposits (USD millions):qk]" pivot="key" type="quantitative" />
            <column name="[Balance label]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[Balance label]" derivation="None" name="[none:Balance label:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
            <format attr="color" value="#183747" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[textscan.BankBalances].[none:Balance label:nk]" />
              <color column="[textscan.BankBalances].[none:Report date:nk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#4f708b" />
                <format attr="mark-labels-show" value="true" />
                <format attr="font-size" value="10" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([textscan.BankBalances].[none:Bank:nk] / [textscan.BankBalances].[none:Report date:nk])</rows>
        <cols>[textscan.BankBalances].[sum:Deposits (USD millions):qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Bank Deposits and Lending">
      <style />
      <size maxheight="1000" maxwidth="1440" minheight="1000" minwidth="1440" />
      <zones>
        <zone h="100000" w="100000" x="0" y="0" id="0" type="layout-basic">
          <zone id="1" x="2000" y="1200" w="96000" h="8500" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="23" bold="true" fontcolor="#293640">Where are bank deposits falling?
</run>
              <run fontname="Arial" fontsize="12" bold="false" fontcolor="#293640">June 2025 vs June 2026 · U.S. banks with $1bn–under $10bn in assets
</run>
              <run fontname="Arial" fontsize="11" bold="false" fontcolor="#293640">Deposits are money held in bank accounts.</run>
            </formatted-text>
          </zone>
          <zone id="2" x="2000" y="11500" w="56000" h="5500" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="12" bold="true" fontcolor="#293640">889 banks have both dates available.
</run>
              <run fontname="Arial" fontsize="10" bold="false" fontcolor="#293640">1 of 890 banks lacks a prior-year comparison and is excluded.</run>
            </formatted-text>
          </zone>
          <zone id="3" name="How many banks had higher or lower deposits?" x="1500" y="18500" w="57500" h="24000">
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="margin" value="8" />
            </zone-style>
          </zone>
          <zone id="4" name="Five largest dollar declines on the 40-bank review list" x="1500" y="52000" w="97000" h="35500">
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="margin" value="8" />
            </zone-style>
          </zone>
          <zone id="5" x="63000" y="11500" w="34000" h="31500" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="13" bold="true" fontcolor="#293640">Which banks warrant a closer look?

</run>
              <run fontname="Arial" fontsize="23" bold="true" fontcolor="#293640">40 of the 159 declining banks
</run>
              <run fontname="Arial" fontsize="12" bold="false" fontcolor="#293640">also had at least $95.30 of net loans for every $100 of deposits.

</run>
              <run fontname="Arial" fontsize="11" bold="false" fontcolor="#293640">The cutoff separates the top 25% of net loan/deposit ratios in this size group.

</run>
              <run fontname="Arial" fontsize="11" bold="false" fontcolor="#293640">The review list identifies joint conditions; it does not establish financial distress.</run>
            </formatted-text>
          </zone>
          <zone id="6" x="2000" y="45000" w="96000" h="5500" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="14" bold="true" fontcolor="#293640">Which five banks on the review list had the largest dollar declines?
</run>
              <run fontname="Arial" fontsize="11" bold="false" fontcolor="#293640">Each pair compares the same bank on the two June 30 dates. USD millions; dollar amounts rounded independently.</run>
            </formatted-text>
          </zone>
          <zone id="7" x="2000" y="90000" w="96000" h="8800" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="11" bold="false" fontcolor="#293640">Deposit changes can reflect mergers, transfers, business models, and other funding sources.
</run>
              <run fontname="Arial" fontsize="10" bold="false" fontcolor="#293640">Bank names refer to individual FDIC entities. The Wells Fargo entry is a subsidiary.
</run>
              <run fontname="Arial" fontsize="10" bold="false" fontcolor="#293640">Source: FDIC BankFind financials API. Extracted 12 Oct 2026 UTC. A saved snapshot of quarter-end balances.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height="32">
    <window class="dashboard" maximized="true" name="Bank Deposits and Lending">
      <viewpoints>
        <viewpoint name="How many banks had higher or lower deposits?">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="Five largest dollar declines on the 40-bank review list">
          <zoom type="entire-view" />
        </viewpoint>
      </viewpoints>
      <active id="0" />
      <device-preview>
        <device is-portrait="true" type="Phone" />
