<?xml version='1.0' encoding='utf-8'?>
<workbook version="10.5" source-platform="win" source-build="10.5.21 (10500.19.1013.2251)" xmlns:user="http://www.tableausoftware.com/xml/user">
  <preferences />
  <datasources>
    <datasource caption="DepositCounts" inline="true" name="textscan.DepositCounts" version="10.5">
      <connection class="textscan" directory="Data" filename="DepositCounts.csv" password="" server="" locale="en_US">
        <relation name="DepositCounts#csv" table="[DepositCounts#csv]" type="table">
          <columns character-set="UTF-8" header="yes" separator="," locale="en_US">
            <column name="Deposit change" datatype="string" ordinal="0" />
            <column name="Number of banks" datatype="integer" ordinal="1" />
            <column name="Label" datatype="string" ordinal="2" />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>Deposit change</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Deposit change]</local-name>
            <parent-name>[DepositCounts#csv]</parent-name>
            <remote-alias>Deposit change</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>Number of banks</remote-name>
            <remote-type>20</remote-type>
            <local-name>[Number of banks]</local-name>
            <parent-name>[DepositCounts#csv]</parent-name>
            <remote-alias>Number of banks</remote-alias>
            <ordinal>1</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>Label</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Label]</local-name>
            <parent-name>[DepositCounts#csv]</parent-name>
            <remote-alias>Label</remote-alias>
            <ordinal>2</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled="yes" />
      <column name="[Deposit change]" datatype="string" role="dimension" type="nominal" />
      <column name="[Number of banks]" datatype="integer" role="measure" type="quantitative" />
      <column name="[Label]" datatype="string" role="dimension" type="nominal" />
      <extract count="-1" enabled="true" units="records">
        <connection class="hyper" dbname="Data/Extracts/DepositCounts.hyper" access_mode="readonly" authentication="auth-none" author-locale="en_US" default-settings="yes" schema="Extract" tablename="Extract" sslmode="" username="tableau_internal_user">
          <relation name="Extract" table="[Extract].[Extract]" type="table" />
          <metadata-records>
            <metadata-record class="column">
              <remote-name>Deposit change</remote-name>
              <remote-type>129</remote-type>
              <local-name>[Deposit change]</local-name>
              <parent-name>[Extract]</parent-name>
              <remote-alias>Deposit change</remote-alias>
              <ordinal>0</ordinal>
              <local-type>string</local-type>
              <aggregation>Count</aggregation>
              <contains-null>true</contains-null>
            </metadata-record>
            <metadata-record class="column">
              <remote-name>Number of banks</remote-name>
              <remote-type>20</remote-type>
              <local-name>[Number of banks]</local-name>
              <parent-name>[Extract]</parent-name>
              <remote-alias>Number of banks</remote-alias>
              <ordinal>1</ordinal>
              <local-type>integer</local-type>
              <aggregation>Sum</aggregation>
              <contains-null>true</contains-null>
            </metadata-record>
            <metadata-record class="column">
              <remote-name>Label</remote-name>
              <remote-type>129</remote-type>
              <local-name>[Label]</local-name>
              <parent-name>[Extract]</parent-name>
